<Window x:Class="AsistentIno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:AsistentIno.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AsistentIno - AI Asistent za Arduino razvoj"
        Height="900"
        Width="1400"
        Background="{StaticResource PrimaryBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="18,12">
            <DockPanel>
                <TextBlock Text="AsistentIno"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding DataFolder, Mode=OneWay}"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="700" />
            </DockPanel>
        </Border>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{StaticResource SecondaryBrush}" Margin="10">
            <Button Content="📁 Odaberi folder" Style="{StaticResource MainButtonStyle}" 
                    Command="{Binding SelectFolderCommand}" Margin="0,0,10,0"/>
            <Button Content="⚙️ Konfiguracija" Style="{StaticResource MainButtonStyle}"
                    Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"/>
            <Button Content="💾 Snimi fajl" Style="{StaticResource MainButtonStyle}"
                    Command="{Binding SaveFileCommand}" Margin="0,0,10,0"/>
        </StackPanel>
        <!-- Status / Notifications -->
        <Border DockPanel.Dock="Bottom"
                        Padding="1" Margin="1,0,1,1" CornerRadius="4" MinHeight="20" MaxHeight="20" Height="20" Background="#FFDBE9E9">
            <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10" Opacity="0.8"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="20"/>
        </Border>
        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Code Editor Section -->
            <DockPanel Grid.Column="0" Background="{StaticResource PrimaryBrush}">
                <!-- File Tabs -->
                <TabControl DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}"
                            ItemsSource="{Binding OpenFiles}"
                            SelectedItem="{Binding SelectedFilePath, Mode=TwoWay}"
                              MinHeight="30"
                              MaxHeight="60"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>

                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="MaxWidth" Value="140"/>
                            <Setter Property="Height" Value="20"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                       ToolTip="{Binding}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <!-- Editor -->
                <!--<TextBox DockPanel.Dock="Bottom" 
                         Text="{Binding SelectedFileContent, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PrimaryBrush}"
                         Foreground="{StaticResource TextBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10"/>-->
                <avalonedit:TextEditor DockPanel.Dock="Bottom"
                        controls:AvalonEditBinding.Text="{Binding SelectedFileContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SyntaxHighlighting="C++"
                       Background="{StaticResource PrimaryBrush}"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="Consolas"
                       FontSize="12"
                       ShowLineNumbers="True"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Padding="10"
                       WordWrap="False" />
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource SecondaryBrush}"/>

            <!-- Right: Agent Section -->
            <DockPanel Grid.Column="2" Background="{StaticResource PrimaryBrush}">
                <!-- Agent Selector -->
                <StackPanel DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}" Margin="10">
                    <TextBlock Text="Agent:" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableAgents}"
                              SelectedItem="{Binding SelectedAgent}"
                              DisplayMemberPath="Name"
                              Padding="5" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Messages -->
                <ScrollViewer x:Name="AgentMessagesScrollViewer" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" 
                              Height="360" Margin="0,10,0,10">
                    <ItemsControl ItemsSource="{Binding AgentMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="10" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Background" Value="#e6eff0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role, StringFormat='[{0}]'}"
                    FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#003366"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                            <Setter Property="Foreground" Value="#cc2e23"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Content}"
                    TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                    FontSize="9" Opacity="0.6" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- User Input -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock Text="Vaša poruka:" FontSize="11" Margin="0,0,0,5"/>
                    <Border Background="{StaticResource SecondaryBrush}"
                            Padding="8" Margin="0,0,0,8" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaitingForInteractiveAnswer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InteractivePrompt}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="{StaticResource SecondaryBrush}"
                            Padding="6" Margin="0,0,0,8" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingAttachment}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button Content="✕" DockPanel.Dock="Right"
                                    Command="{Binding RemoveAttachmentCommand}"
                                    Padding="6,0" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding PendingAttachment.FileName, StringFormat='📎 {0}'}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <TextBox Text="{Binding UserMessage, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SecondaryBrush}"
                             Foreground="{StaticResource TextBrush}"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             Height="80"
                             Padding="10"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="📎 Prilog" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding AttachFileCommand}"
                                Margin="0,0,5,0"/>
                        <Button Content="Pošalji" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding SendMessageCommand}"
                                Margin="0,0,5,0"/>
                        <Button Content="Otkaži" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Obrisi istoriju" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding ClearHistoryCommand}"/>
                    </StackPanel>
                </StackPanel>


            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
