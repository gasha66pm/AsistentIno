<Window x:Class="AsistentIno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:AsistentIno.Controls"
        xmlns:local="clr-namespace:AsistentIno.Converters"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"   
        mc:Ignorable="d"
        Title="AsistentIno - AI Asistent za Arduino razvoj"
        Height="900"
        Width="1400"
        Background="{StaticResource PrimaryBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <local:SyntaxHighlightingConverter x:Key="SyntaxHighlightingConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="18,12">
            <DockPanel>
                <TextBlock Text="AsistentIno"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding DataFolder, Mode=OneWay}"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="700" />
            </DockPanel>
        </Border>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{StaticResource SecondaryBrush}" Margin="10">
            <Button Content="📁 Odaberi folder" Style="{StaticResource MainButtonStyle}" 
                    Command="{Binding SelectFolderCommand}" Margin="0,0,10,0"/>
            <Button Content="⚙️ Konfiguracija" Style="{StaticResource MainButtonStyle}"
                    Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"/>
            <Button Content="💾 Snimi fajl" Style="{StaticResource MainButtonStyle}"
                    Command="{Binding SaveFileCommand}" Margin="0,0,10,0"/>
            <Button Content="⚡ Compile" Style="{StaticResource MainButtonStyle}"
                    Click="OpenCompileWindow_Click" Margin="0,0,10,0"/>
        </StackPanel>
        <!-- Status / Notifications -->
        <Border DockPanel.Dock="Bottom"
                        Padding="1" Margin="1,0,1,1" CornerRadius="4" MinHeight="20" MaxHeight="20" Height="20" Background="#FFDBE9E9">
            <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10" Opacity="0.8"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="20"/>
        </Border>
        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Code Editor Section -->
            <DockPanel Grid.Column="0" Background="{StaticResource PrimaryBrush}">
                <ComboBox DockPanel.Dock="Top"
          ItemsSource="{Binding OpenFiles}"
          SelectedItem="{Binding SelectedFilePath, Mode=TwoWay}"
          Background="{StaticResource SecondaryBrush}"
          Foreground="{StaticResource TextBrush}"
          MinHeight="30"
          Margin="5"
          Padding="6">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                       ToolTip="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Editor -->

                <Grid DockPanel.Dock="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <avalonedit:TextEditor
        x:Name="CodeEditor"
        controls:AvalonEditBinding.Text="{Binding SelectedFileContent,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
        SyntaxHighlighting="{Binding IsSyntaxHighlightingEnabled,
                                     Converter={StaticResource SyntaxHighlightingConverter}}"
        Background="{StaticResource PrimaryBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Consolas"
        FontSize="12"
        ShowLineNumbers="True"
        WordWrap="False"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        Visibility="{Binding IsSvgFile,
                             Converter={StaticResource InverseBooleanToVisibilityConverter}}"
        Grid.Row="0" />

                    <!-- Find Panel -->
                    <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                            Padding="8" Visibility="Collapsed" x:Name="FindPanel">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" 
                                    Click="CloseFindPanel_Click" Width="30" Height="30" 
                                    Padding="0"
                                    Margin="5,0,0,0" ToolTip="Zatvori (ESC)" />
                            <Button DockPanel.Dock="Right" Content="▼" x:Name="FindNextBtn"
                                    Click="FindNext_Click" Width="30" Height="30" 
                                    Padding="0"
                                    Margin="0,0,5,0" ToolTip="Sledeći" />
                            <Button DockPanel.Dock="Right" Content="▲" x:Name="FindPrevBtn"
                                    Click="FindPrevious_Click" Width="30" Height="30" 
                                    Padding="0"
                                    Margin="0,0,5,0" ToolTip="Prethodni" />
                            <TextBlock DockPanel.Dock="Right" x:Name="MatchCountLabel" 
                                       Foreground="{StaticResource TextBrush}" 
                                       VerticalAlignment="Center" Margin="10,0" />
                            <TextBox x:Name="FindTextBox"
                                     Background="{StaticResource PrimaryBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     Padding="8,6" 
                                     TextChanged="FindTextBox_TextChanged"
                                     PreviewKeyDown="FindTextBox_PreviewKeyDown"
                                     Margin="0,0,5,0"
                                     ToolTip="Traži tekst (Ctrl+F)" />
                        </DockPanel>
                    </Border>

                    <Border
        Background="White"
        Padding="20"
        Visibility="{Binding IsSvgFile,
                             Converter={StaticResource BooleanToVisibilityConverter}}"
        Grid.Row="0"
        Grid.RowSpan="2">

                        <svgc:SvgViewbox
            Source="{Binding SelectedFileUri}"
            Stretch="Uniform" />
                    </Border>

                </Grid>
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource SecondaryBrush}"/>

            <!-- Right: Agent Section -->
            <DockPanel Grid.Column="2" Background="{StaticResource PrimaryBrush}">
                <!-- Agent Selector -->
                <StackPanel DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}" Margin="10">
                    <TextBlock Text="Agent:" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableAgents}"
                              SelectedItem="{Binding SelectedAgent}"
                              DisplayMemberPath="Name"
                              Padding="5" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Messages -->
                <ScrollViewer x:Name="AgentMessagesScrollViewer" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" 
                              Height="360" Margin="0,10,0,10">
                    <ItemsControl ItemsSource="{Binding AgentMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="10" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Background" Value="#e6eff0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0">Traži:</TextBlock>
                                            <Button DockPanel.Dock="Right"
                                                Content="📋"
                                                CommandParameter="{Binding Content}"
                                                Click="CopyMessage_Click"
                                                Padding="4,1"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                ToolTip="Kopiraj poruku"
                                                Cursor="Hand"/>

                                            <TextBlock Text="{Binding Role, StringFormat='[{0}]'}"
                                                   FontWeight="Bold"
                                                   FontSize="11">   
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#003366"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                <Setter Property="Foreground" Value="#cc2e23"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <md:MarkdownScrollViewer
                                            Markdown="{Binding Content}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="0,5,0,0"
                                            FontSize="8"
                                            VerticalScrollBarVisibility="Disabled"
                                            PreviewMouseWheel="MarkdownScrollViewer_PreviewMouseWheel"/>        
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                    FontSize="9" Opacity="0.6" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- User Input -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock Text="Vaša poruka:" FontSize="11" Margin="0,0,0,5"/>
                    <Border Background="{StaticResource SecondaryBrush}"
                            Padding="8" Margin="0,0,0,8" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaitingForInteractiveAnswer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InteractivePrompt}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="{StaticResource SecondaryBrush}"
                            Padding="6" Margin="0,0,0,8" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingAttachment}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button Content="✕" DockPanel.Dock="Right"
                                    Command="{Binding RemoveAttachmentCommand}"
                                    Padding="6,0" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding PendingAttachment.FileName, StringFormat='📎 {0}'}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <TextBox Text="{Binding UserMessage, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SecondaryBrush}"
                             Foreground="{StaticResource TextBrush}"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             Height="80"
                             Padding="10"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="📎 Prilog" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding AttachFileCommand}"
                                Margin="0,0,5,0"/>
                        <Button Content="Pošalji" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding SendMessageCommand}"
                                Margin="0,0,5,0"/>
                        <Button Content="Otkaži" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Obrisi istoriju" Style="{StaticResource MainButtonStyle}"
                                Command="{Binding ClearHistoryCommand}"/>
                    </StackPanel>
                </StackPanel>


            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
